{
  "version": "v1",
  "prefix": "/api/v1",
  "legacyPrefix": "/api",
  "endpoints": [
    {
      "method": "POST",
      "path": "/api/v1/auth/login",
      "authenticated": false,
      "idempotent": false
    },
    {
      "method": "POST",
      "path": "/api/v1/auth/refresh",
      "authenticated": false,
      "idempotent": false
    },
    {
      "method": "GET",
      "path": "/api/v1/auth/me",
      "authenticated": true,
      "idempotent": false
    },
    {
      "method": "POST",
      "path": "/api/v1/auth/logout",
      "authenticated": true,
      "idempotent": false
    },
    {
      "method": "GET",
      "path": "/api/v1/items",
      "authenticated": true,
      "idempotent": false
    },
    {
      "method": "GET",
      "path": "/api/v1/items/:id",
      "authenticated": true,
      "idempotent": false
    },
    {
      "method": "POST",
      "path": "/api/v1/items",
      "authenticated": true,
      "idempotent": true
    },
    {
      "method": "PATCH",
      "path": "/api/v1/items/:id",
      "authenticated": true,
      "idempotent": true
    },
    {
      "method": "DELETE",
      "path": "/api/v1/items/:id",
      "authenticated": true,
      "idempotent": true
    },
    {
      "method": "POST",
      "path": "/api/v1/files/upload-sessions",
      "authenticated": true,
      "idempotent": true
    },
    {
      "method": "PUT",
      "path": "/api/v1/files/upload-sessions/:id/content",
      "authenticated": true,
      "idempotent": false
    },
    {
      "method": "POST",
      "path": "/api/v1/files/upload-sessions/:id/complete",
      "authenticated": true,
      "idempotent": true
    },
    {
      "method": "DELETE",
      "path": "/api/v1/files/upload-sessions/:id",
      "authenticated": true,
      "idempotent": true
    },
    {
      "method": "GET",
      "path": "/api/v1/files/:id/download",
      "authenticated": true,
      "idempotent": false
    },
    {
      "method": "DELETE",
      "path": "/api/v1/files/:id",
      "authenticated": true,
      "idempotent": true
    }
  ],
  "closedEnums": {
    "ApiErrorCode": [
      "validation_error",
      "invalid_cursor",
      "not_found",
      "conflict",
      "unauthorized",
      "forbidden",
      "rate_limited",
      "payload_too_large",
      "checksum_mismatch",
      "upload_expired",
      "capability_missing",
      "internal_error"
    ],
    "ItemStatus": ["draft", "ready"],
    "FileStatus": ["pending", "ready", "deleted"]
  },
  "requestSchemas": {
    "CreateItem": {
      "title": { "type": "string", "required": true }
    },
    "UpdateItem": {
      "title": { "type": "string", "required": true },
      "version": { "type": "positive-integer", "required": true }
    },
    "DeleteItemQuery": {
      "version": { "type": "positive-integer", "required": true }
    },
    "Login": {
      "email": { "type": "email-string", "required": true },
      "password": { "type": "string", "required": true }
    },
    "Refresh": {
      "refreshToken": { "type": "string", "required": true }
    },
    "InitiateUpload": {
      "originalName": { "type": "string", "required": true },
      "displayName": { "type": "string", "required": true },
      "mimeType": { "type": "string", "required": true },
      "sizeBytes": { "type": "positive-integer", "required": true },
      "checksum": { "type": "sha256-hex", "required": true }
    }
  },
  "responseSchemas": {
    "Item": {
      "id": { "type": "string", "required": true },
      "tenantId": { "type": "string", "required": true },
      "title": { "type": "string", "required": true },
      "status": { "type": "ItemStatus", "required": true },
      "version": { "type": "positive-integer", "required": true },
      "createdAt": { "type": "iso-string", "required": true },
      "updatedAt": { "type": "iso-string", "required": true },
      "deletedAt": { "type": "nullable-iso-string", "required": true }
    },
    "FileMetadata": {
      "fileId": { "type": "string", "required": true },
      "ownerId": { "type": "string", "required": true },
      "tenantId": { "type": "string", "required": true },
      "originalName": { "type": "string", "required": true },
      "displayName": { "type": "string", "required": true },
      "mimeType": { "type": "string", "required": true },
      "sizeBytes": { "type": "nonnegative-integer", "required": true },
      "checksum": { "type": "string", "required": true },
      "status": { "type": "FileStatus", "required": true },
      "createdAt": { "type": "iso-string", "required": true },
      "deletedAt": { "type": "nullable-iso-string", "required": true }
    },
    "AuthIdentity": {
      "userId": { "type": "string", "required": true },
      "email": { "type": "email-string", "required": true },
      "tenantId": { "type": "string", "required": true },
      "roles": { "type": "string-array", "required": true }
    },
    "AuthTokenResponse": {
      "accessToken": { "type": "string", "required": true },
      "refreshToken": { "type": "string", "required": true },
      "accessTokenExpiresAt": { "type": "iso-string", "required": true },
      "refreshTokenExpiresAt": { "type": "iso-string", "required": true }
    },
    "UploadSession": {
      "sessionId": { "type": "string", "required": true },
      "fileId": { "type": "string", "required": true },
      "expiresAt": { "type": "iso-string", "required": true },
      "resumable": { "type": "boolean", "required": true }
    },
    "UploadProgress": {
      "bytesReceived": { "type": "nonnegative-integer", "required": true },
      "complete": { "type": "boolean", "required": true }
    },
    "ApiErrorResponse": {
      "error": { "type": "error-object", "required": true },
      "requestId": { "type": "string", "required": true }
    }
  }
}
