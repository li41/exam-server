# Recovery-only R2 S3 credentials. The token MUST use Object Read only.
# Keep the populated file off-host. Copy it to /run/server-foundation/offsite-restore.env
# only for a restore/rehearsal, chmod 0600 root:root, then remove it afterwards.
R2_ACCOUNT_ID=CHANGE_ME
R2_BUCKET=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_PREFIX=server-foundation/backups
