# Copy to /etc/server-foundation/server-foundation.env and chmod 600.
# Never commit the populated production file.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787

MYSQL_URL=mysql://server_foundation:CHANGE_ME@127.0.0.1:3306/server_foundation
REDIS_URL=redis://127.0.0.1:6379
FILE_STORAGE_ROOT=/var/lib/server-foundation/storage

# Non-secret machine identity used by backup/restore safety checks.
# DEPLOYMENT_COMPANY_ID must equal exam-control company_id (positive INTEGER).
# DEPLOYMENT_PROJECT_ID distinguishes two deployments for the same company.
DEPLOYMENT_COMPANY_ID=CHANGE_ME
DEPLOYMENT_PROJECT_ID=CHANGE_ME

TRUST_PROXY_HEADERS=true
FILE_CLEANUP_INTERVAL_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=86400
SHUTDOWN_TIMEOUT_SECONDS=30

# Used by the backup command, not by the API process itself.
BACKUP_ROOT=/var/backups/server-foundation
