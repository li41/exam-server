# Steady-state host credential: upload-only Cloudflare Worker endpoint.
# Keep the populated file at /etc/server-foundation/offsite-backup.env mode 0600 root:root.
# Do NOT put an R2 Object Read & Write key on the host.
OFFSITE_UPLOAD_URL=https://CHANGE_ME.workers.dev/
OFFSITE_UPLOAD_TOKEN=CHANGE_ME
OFFSITE_UPLOAD_PART_SIZE_MIB=8
R2_PREFIX=server-foundation/backups
