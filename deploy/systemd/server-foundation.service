[Unit]
Description=server-foundation API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=server-foundation
Group=server-foundation
WorkingDirectory=/opt/server-foundation/current
EnvironmentFile=/etc/server-foundation/server-foundation.env
ExecStart=/usr/bin/node /opt/server-foundation/current/apps/api/dist/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=40s
KillSignal=SIGTERM
UMask=0077

StateDirectory=server-foundation
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
ReadWritePaths=/var/lib/server-foundation
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=server-foundation

[Install]
WantedBy=multi-user.target
