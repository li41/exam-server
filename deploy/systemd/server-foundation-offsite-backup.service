[Unit]
Description=server-foundation daily off-site backup to Cloudflare R2
Wants=network-online.target
After=network-online.target mysqld.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/server-foundation-offsite-backup
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/server-foundation /var/lib/server-foundation
ReadWritePaths=/var/backups/server-foundation

StandardOutput=journal
StandardError=journal
SyslogIdentifier=server-foundation-offsite-backup
